# renovate: datasource=docker depName=docker.io/library/golang
ARG GO_TAG=1.27.3@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ARG BASE_REGISTRY=registry.access.redhat.com
ARG BASE_IMAGE=ubi9/ubi-minimal
# renovate: datasource=docker depName=registry.access.redhat.com/ubi9/ubi-minimal
ARG BASE_TAG=latest@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

FROM docker.io/library/golang:${GO_TAG} AS build
ARG UPSTREAM_VERSION=v1.2.3
ARG UPSTREAM_COMMIT=0123456789abcdef0123456789abcdef01234567
WORKDIR /src
RUN echo "${UPSTREAM_VERSION} ${UPSTREAM_COMMIT}" > /out

FROM ${BASE_REGISTRY}/${BASE_IMAGE}:${BASE_TAG}
ARG UPSTREAM_VERSION=v1.2.3
ARG UPSTREAM_COMMIT=0123456789abcdef0123456789abcdef01234567
ARG RELEASE=0
# Set by scripts/build-image.sh (ADR-009): the commit of this repository that
# built the image, when, and the digest of the base it sits on.
ARG VCS_REF=unknown
ARG BUILD_DATE=1970-01-01T00:00:00Z
ARG BASE_DIGEST=unknown
# Declared before the first FROM; repeated here so the labels can use them.
ARG BASE_REGISTRY
ARG BASE_IMAGE
LABEL name="stakater/image-good" \
      vendor="Stakater AB" \
      maintainer="Stakater AB <support@stakater.com>" \
      version="${UPSTREAM_VERSION}" \
      release="${RELEASE}" \
      summary="Example image used by tests" \
      description="Fixture that satisfies every rule in scripts/check-image.sh." \
      io.k8s.display-name="Stakater build of Example" \
      io.k8s.description="Fixture that satisfies every rule in scripts/check-image.sh." \
      io.openshift.tags="example,testing" \
      org.opencontainers.image.title="Stakater build of Example" \
      org.opencontainers.image.description="Fixture that satisfies every rule in scripts/check-image.sh." \
      org.opencontainers.image.vendor="Stakater AB" \
      org.opencontainers.image.version="${UPSTREAM_VERSION}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/stakater/certified-images" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.url="https://github.com/stakater/certified-images/tree/main/images/image-good" \
      org.opencontainers.image.base.name="${BASE_REGISTRY}/${BASE_IMAGE}" \
      org.opencontainers.image.base.digest="${BASE_DIGEST}" \
      vcs-ref="${VCS_REF}" \
      vcs-type="git" \
      build-date="${BUILD_DATE}" \
      url="https://github.com/stakater/certified-images/tree/main/images/image-good" \
      com.stakater.upstream.repo="https://github.com/example/example" \
      com.stakater.upstream.version="${UPSTREAM_VERSION}" \
      com.stakater.upstream.commit="${UPSTREAM_COMMIT}"
COPY --from=build /out /out
USER 1001
ENTRYPOINT ["/out"]
