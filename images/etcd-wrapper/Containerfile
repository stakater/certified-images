# Stakater build of etcd-wrapper: rebuilt from upstream source on Red Hat UBI.
# Hermetic (ADR-003): scripts/build-image.sh fetches the pinned commit into ./src,
# Hermeto-prefetches Go modules into ./hermeto-output, then builds with the network off.
# Base images are parameterised and digest-pinned (ADR-004).

# Build-stage toolchain: not shipped, pinned by digest all the same (ADR-004).
# Upstream's go.mod says go 1.26.0; upstream's own Dockerfile builds with 1.26.10.
# renovate: datasource=docker depName=docker.io/library/golang
ARG GO_TAG=1.26.10@sha256:cfa27959837144bf4649802ba38e59daffd0dd2a7994aa83daaf113285b0f551
ARG BASE_REGISTRY=registry.access.redhat.com
ARG BASE_IMAGE=ubi9/ubi-minimal
# renovate: datasource=docker depName=registry.access.redhat.com/ubi9/ubi-minimal
ARG BASE_TAG=latest@sha256:08d4c70f1baf6537a0728656cf7942d561e74a35916509d205b6519861266352

########## build stage (not shipped) ##########
FROM docker.io/library/golang:${GO_TAG} AS build
# renovate: datasource=github-tags depName=gardener/etcd-wrapper
ARG UPSTREAM_VERSION=v0.8.4
ARG UPSTREAM_COMMIT=762fc3acabffe4bf4e362a3733b90475701d5eb1
COPY src/ /src/
COPY hermeto-output/ /tmp/hermeto-output/
COPY hermeto.env /tmp/hermeto.env
WORKDIR /src
# No network here: modules come from the Hermeto cache (GOPROXY/GOMODCACHE set by hermeto.env).
# Upstream's vendor/ was dropped before the prefetch (image.yaml, ADR-003 §7).
# Upstream builds main.go with no version flags.
RUN . /tmp/hermeto.env && \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags "-s -w" -o /out/etcd-wrapper . && \
    mkdir /out/home

########## runtime stage (certified) ##########
FROM ${BASE_REGISTRY}/${BASE_IMAGE}:${BASE_TAG}

# renovate: datasource=github-tags depName=gardener/etcd-wrapper
ARG UPSTREAM_VERSION=v0.8.4
ARG UPSTREAM_COMMIT=762fc3acabffe4bf4e362a3733b90475701d5eb1
ARG RELEASE=0
# Set by scripts/build-image.sh (ADR-009): the commit of this repository that
# built the image, when, and the digest of the base it sits on.
ARG VCS_REF=unknown
ARG BUILD_DATE=1970-01-01T00:00:00Z
ARG BASE_DIGEST=unknown
# Declared before the first FROM; repeated here so the labels can use them.
ARG BASE_REGISTRY
ARG BASE_IMAGE

# Labels (ADR-009). scripts/check-labels.sh checks every one against image.yaml
# and the build. Without them the image would inherit UBI's build date, commit,
# URL and tags.
LABEL name="stakater/etcd-wrapper" \
      vendor="Stakater AB" \
      maintainer="Stakater AB <support@stakater.com>" \
      version="${UPSTREAM_VERSION}" \
      release="${RELEASE}" \
      summary="etcd-wrapper, the etcd server used by etcd-druid, rebuilt from source on Red Hat UBI" \
      description="etcd-wrapper starts an embedded etcd server configured by the etcd-backup-restore sidecar. It is the etcd container in every etcd pod that the Gardener etcd-druid operator creates. Rebuilt by Stakater from the upstream source on Red Hat Universal Base Image." \
      io.k8s.display-name="Stakater build of etcd-wrapper" \
      io.k8s.description="etcd-wrapper starts an embedded etcd server configured by the etcd-backup-restore sidecar. It is the etcd container in every etcd pod that the Gardener etcd-druid operator creates. Rebuilt by Stakater from the upstream source on Red Hat Universal Base Image." \
      io.openshift.tags="etcd,etcd-wrapper,etcd-druid,gardener,database" \
      org.opencontainers.image.title="Stakater build of etcd-wrapper" \
      org.opencontainers.image.description="etcd-wrapper starts an embedded etcd server configured by the etcd-backup-restore sidecar. It is the etcd container in every etcd pod that the Gardener etcd-druid operator creates. Rebuilt by Stakater from the upstream source on Red Hat Universal Base Image." \
      org.opencontainers.image.vendor="Stakater AB" \
      org.opencontainers.image.version="${UPSTREAM_VERSION}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/stakater/certified-images" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.url="https://github.com/stakater/certified-images/tree/main/images/etcd-wrapper" \
      org.opencontainers.image.base.name="${BASE_REGISTRY}/${BASE_IMAGE}" \
      org.opencontainers.image.base.digest="${BASE_DIGEST}" \
      vcs-ref="${VCS_REF}" \
      vcs-type="git" \
      build-date="${BUILD_DATE}" \
      url="https://github.com/stakater/certified-images/tree/main/images/etcd-wrapper" \
      com.stakater.upstream.repo="https://github.com/gardener/etcd-wrapper" \
      com.stakater.upstream.version="${UPSTREAM_VERSION}" \
      com.stakater.upstream.commit="${UPSTREAM_COMMIT}"

# No package installs or updates here: the build has no network. OS fixes
# arrive through Renovate base-digest bumps (ADR-003 §5, ADR-004).

# Red Hat certification: /licenses (HasLicense). Keep upstream's licence files.
# Upstream ships LICENSE and a LICENSES directory (REUSE).
COPY --from=build /src/LICENSE /licenses/LICENSE
COPY --from=build /src/LICENSES/ /licenses/LICENSES/

# Same path as upstream's image: etcd-druid passes arguments only.
COPY --from=build --chown=1001:0 --chmod=0555 /out/etcd-wrapper /etcd-wrapper
# A home directory writable by group 0, at upstream's path. The backup-restore
# sidecar writes the etcd configuration into HOME; under an arbitrary UID
# (OpenShift) HOME would otherwise be "/", which is not writable.
COPY --from=build --chown=1001:0 --chmod=0770 /out/home /home/nonroot
ENV HOME=/home/nonroot
WORKDIR /

# Etcd clients on 2379, peers on 2380, the wrapper's readiness endpoint on 9095.
EXPOSE 2379 2380 9095

# Non-root, and usable under an arbitrary UID in group 0 (OpenShift).
USER 1001

ENTRYPOINT ["/etcd-wrapper"]
