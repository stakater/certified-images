# Stakater build of OpenCost: rebuilt from upstream source on Red Hat UBI.
# Hermetic (ADR-003): scripts/build-image.sh fetches the pinned commit into ./src,
# Hermeto-prefetches Go modules into ./hermeto-output, then builds with the network off.
# Base images are parameterised and digest-pinned (ADR-004).

# Build-stage toolchain: not shipped, pinned by digest all the same (ADR-004).
# The Go version must satisfy the `go` directive in upstream's go.mod.
# renovate: datasource=docker depName=docker.io/library/golang
ARG GO_TAG=1.27.3@sha256:e519d3b0a5b285e5aa53ab9eef02bc6bbb9cb04608389b743a136a9ce75f0d1e
ARG BASE_REGISTRY=registry.access.redhat.com
ARG BASE_IMAGE=ubi9/ubi-minimal
# renovate: datasource=docker depName=registry.access.redhat.com/ubi9/ubi-minimal
ARG BASE_TAG=latest@sha256:08d4c70f1baf6537a0728656cf7942d561e74a35916509d205b6519861266352

########## build stage (not shipped) ##########
FROM docker.io/library/golang:${GO_TAG} AS build
# renovate: datasource=github-tags depName=opencost/opencost
ARG UPSTREAM_VERSION=v1.121.5
ARG UPSTREAM_COMMIT=32dbf049c84c66db1efeb9fc9a98e5042f076cf1
COPY src/ /src/
COPY hermeto-output/ /tmp/hermeto-output/
COPY hermeto.env /tmp/hermeto.env
WORKDIR /src/cmd/costmodel
# No network here: modules come from the Hermeto cache (GOPROXY/GOMODCACHE set by hermeto.env).
RUN . /tmp/hermeto.env && \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath \
      -ldflags "-s -w \
        -X github.com/opencost/opencost/core/pkg/version.Version=${UPSTREAM_VERSION} \
        -X github.com/opencost/opencost/core/pkg/version.GitCommit=${UPSTREAM_COMMIT}" \
      -o /out/costmodel

########## runtime stage (certified) ##########
FROM ${BASE_REGISTRY}/${BASE_IMAGE}:${BASE_TAG}

# renovate: datasource=github-tags depName=opencost/opencost
ARG UPSTREAM_VERSION=v1.121.5
ARG UPSTREAM_COMMIT=32dbf049c84c66db1efeb9fc9a98e5042f076cf1
ARG RELEASE=0
# Set by scripts/build-image.sh (ADR-009): the commit of this repository that
# built the image, when, and the digest of the base it sits on.
ARG VCS_REF=unknown
ARG BUILD_DATE=1970-01-01T00:00:00Z
ARG BASE_DIGEST=unknown
# Declared before the first FROM; repeated here so the labels can use them.
ARG BASE_REGISTRY
ARG BASE_IMAGE

# Labels (ADR-009). scripts/check-labels.sh checks every one against image.yaml
# and the build. Without them the image would inherit UBI's build date, commit,
# URL and tags.
LABEL name="stakater/opencost" \
      vendor="Stakater AB" \
      maintainer="Stakater AB <support@stakater.com>" \
      version="${UPSTREAM_VERSION}" \
      release="${RELEASE}" \
      summary="OpenCost cost model rebuilt from source on Red Hat UBI" \
      description="OpenCost cost-allocation engine for Kubernetes, rebuilt by Stakater from the upstream source on Red Hat Universal Base Image and certified for OpenShift. Used by Multi-Tenant Operator FinOps/showback." \
      io.k8s.display-name="Stakater build of OpenCost" \
      io.k8s.description="OpenCost cost-allocation engine for Kubernetes, rebuilt by Stakater from the upstream source on Red Hat Universal Base Image and certified for OpenShift. Used by Multi-Tenant Operator FinOps/showback." \
      io.openshift.tags="opencost,cost,finops,kubernetes" \
      org.opencontainers.image.title="Stakater build of OpenCost" \
      org.opencontainers.image.description="OpenCost cost-allocation engine for Kubernetes, rebuilt by Stakater from the upstream source on Red Hat Universal Base Image and certified for OpenShift. Used by Multi-Tenant Operator FinOps/showback." \
      org.opencontainers.image.vendor="Stakater AB" \
      org.opencontainers.image.version="${UPSTREAM_VERSION}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/stakater/certified-images" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.url="https://github.com/stakater/certified-images/tree/main/images/opencost" \
      org.opencontainers.image.base.name="${BASE_REGISTRY}/${BASE_IMAGE}" \
      org.opencontainers.image.base.digest="${BASE_DIGEST}" \
      vcs-ref="${VCS_REF}" \
      vcs-type="git" \
      build-date="${BUILD_DATE}" \
      url="https://github.com/stakater/certified-images/tree/main/images/opencost" \
      com.stakater.upstream.repo="https://github.com/opencost/opencost" \
      com.stakater.upstream.version="${UPSTREAM_VERSION}" \
      com.stakater.upstream.commit="${UPSTREAM_COMMIT}"

# No microdnf update here (no network in the build). OS fixes arrive via
# Renovate base-digest bumps (ADR-003 §5, ADR-004). ubi-minimal ships CA certs.

# Red Hat certification: /licenses (HasLicense). Keep upstream LICENSE/NOTICE.
COPY --from=build /src/LICENSE /licenses/LICENSE
COPY --from=build /src/NOTICE /licenses/NOTICE
COPY --from=build /src/THIRD_PARTY_LICENSES.txt /licenses/THIRD_PARTY_LICENSES.txt

# Pricing models, same layout as upstream (/models/*.json)
COPY --from=build --chown=1001:0 /src/configs/ /models/
COPY --from=build --chown=1001:0 --chmod=0555 /out/costmodel /go/bin/app

# Non-root, OpenShift arbitrary-UID friendly (group 0 = owner perms)
RUN chmod -R g=u /models
USER 1001

ENTRYPOINT ["/go/bin/app"]
