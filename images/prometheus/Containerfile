# Stakater build of Prometheus (server with its web UI built in, and promtool): rebuilt from upstream source on Red Hat UBI.
# Hermetic (ADR-003): scripts/build-image.sh fetches the pinned commit into ./src,
# Hermeto-prefetches Go modules and the web UI's pnpm packages into ./hermeto-output,
# then builds with the network off.
# Base images are parameterised and digest-pinned (ADR-004).

# Build-stage toolchain: not shipped, pinned by digest all the same (ADR-004).
# Upstream's go.mod says go 1.26.7; upstream builds releases with Go 1.27 (.promu.yml).
# renovate: datasource=docker depName=docker.io/library/golang
ARG GO_TAG=1.27.3@sha256:e519d3b0a5b285e5aa53ab9eef02bc6bbb9cb04608389b743a136a9ce75f0d1e
ARG BASE_REGISTRY=registry.access.redhat.com
ARG BASE_IMAGE=ubi9/ubi-minimal
# renovate: datasource=docker depName=registry.access.redhat.com/ubi9/ubi-minimal
ARG BASE_TAG=latest@sha256:08d4c70f1baf6537a0728656cf7942d561e74a35916509d205b6519861266352

########## web UI stage (not shipped) ##########
# The UI is JavaScript built with pnpm (story P.1b). Two pinned images: pnpm's
# own, for the pnpm program, and Node, to run it and the build.
# pnpm stays on 11.x: 12 refuses the relative tarball paths Hermeto writes into
# the lockfile for an offline install (seen 2026-11-28). renovate.json holds it.
FROM ghcr.io/pnpm/pnpm:11.29.0@sha256:e8ac4859e062e6a9d2723f3d59d7da6bda03907e9c35227458cba187ec7290fe AS pnpm
# Node 24, as upstream's web/ui/.nvmrc asks. The full image, not -slim: pnpm 11
# needs libatomic, which -slim lacks.
FROM docker.io/library/node:24.21.0-bookworm@sha256:3d27e5c11e5786e309ec3e03f93ae536eb36e6e5eb3714d5eb3300a36157add0 AS ui
COPY --from=pnpm /opt/pnpm /opt/pnpm
ENV PATH=/opt/pnpm:$PATH
COPY src/ /src/
COPY hermeto-output/ /tmp/hermeto-output/
COPY hermeto.env /tmp/hermeto.env
WORKDIR /src/web/ui
# No network here: packages come from the Hermeto output, through the registry
# setting Hermeto wrote into each .npmrc. Then upstream's own steps: install
# both lockfiles, build both UIs, compress the assets and generate embed.go.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN . /tmp/hermeto.env && \
    pnpm install --frozen-lockfile && \
    pnpm --dir react-app install --frozen-lockfile && \
    CI="" pnpm run build
WORKDIR /src
RUN scripts/compress_assets.sh

########## build stage (not shipped) ##########
FROM docker.io/library/golang:${GO_TAG} AS build
# renovate: datasource=github-tags depName=prometheus/prometheus
ARG UPSTREAM_VERSION=v3.16.0
ARG UPSTREAM_COMMIT=e2e28adeee2c5883d000fc82aca6008cfbf7e96d
COPY src/ /src/
COPY hermeto-output/ /tmp/hermeto-output/
COPY hermeto.env /tmp/hermeto.env
# The compressed UI assets and the generated embed.go, from the stage above.
COPY --from=ui /src/web/ui/static/ /src/web/ui/static/
COPY --from=ui /src/web/ui/embed.go /src/web/ui/embed.go
WORKDIR /src
# No network here: modules come from the Hermeto cache (GOPROXY/GOMODCACHE set by hermeto.env).
# Build tags and version flags as in upstream's .promu.yml: builtinassets puts
# the UI into the binary. The version is the tag without its "v".
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN . /tmp/hermeto.env && \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -tags netgo,builtinassets \
      -ldflags "-s -w \
        -X github.com/prometheus/common/version.Version=${UPSTREAM_VERSION#v} \
        -X github.com/prometheus/common/version.Revision=${UPSTREAM_COMMIT}" \
      -o /out/ ./cmd/prometheus ./cmd/promtool && \
    mkdir -p /out/rootfs/prometheus && chmod 0770 /out/rootfs/prometheus

########## runtime stage (certified) ##########
FROM ${BASE_REGISTRY}/${BASE_IMAGE}:${BASE_TAG}

# renovate: datasource=github-tags depName=prometheus/prometheus
ARG UPSTREAM_VERSION=v3.16.0
ARG UPSTREAM_COMMIT=e2e28adeee2c5883d000fc82aca6008cfbf7e96d
ARG RELEASE=0
# Set by scripts/build-image.sh (ADR-009): the commit of this repository that
# built the image, when, and the digest of the base it sits on.
ARG VCS_REF=unknown
ARG BUILD_DATE=1970-01-01T00:00:00Z
ARG BASE_DIGEST=unknown
# Declared before the first FROM; repeated here so the labels can use them.
ARG BASE_REGISTRY
ARG BASE_IMAGE

# Labels (ADR-009). scripts/check-labels.sh checks every one against image.yaml
# and the build. Without them the image would inherit UBI's build date, commit,
# URL and tags.
LABEL name="stakater/prometheus" \
      vendor="Stakater AB" \
      maintainer="Stakater AB <support@stakater.com>" \
      version="${UPSTREAM_VERSION}" \
      release="${RELEASE}" \
      summary="Prometheus monitoring system and time series database rebuilt from source on Red Hat UBI" \
      description="Prometheus collects metrics from configured targets, stores them as time series, evaluates rules and answers queries. This image holds the Prometheus server with its web UI built in, and promtool. Rebuilt by Stakater from the upstream source on Red Hat Universal Base Image." \
      io.k8s.display-name="Stakater build of prometheus" \
      io.k8s.description="Prometheus collects metrics from configured targets, stores them as time series, evaluates rules and answers queries. This image holds the Prometheus server with its web UI built in, and promtool. Rebuilt by Stakater from the upstream source on Red Hat Universal Base Image." \
      io.openshift.tags="prometheus,monitoring,metrics,alerting,time-series" \
      org.opencontainers.image.title="Stakater build of prometheus" \
      org.opencontainers.image.description="Prometheus collects metrics from configured targets, stores them as time series, evaluates rules and answers queries. This image holds the Prometheus server with its web UI built in, and promtool. Rebuilt by Stakater from the upstream source on Red Hat Universal Base Image." \
      org.opencontainers.image.vendor="Stakater AB" \
      org.opencontainers.image.version="${UPSTREAM_VERSION}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/stakater/certified-images" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.url="https://github.com/stakater/certified-images/tree/main/images/prometheus" \
      org.opencontainers.image.base.name="${BASE_REGISTRY}/${BASE_IMAGE}" \
      org.opencontainers.image.base.digest="${BASE_DIGEST}" \
      vcs-ref="${VCS_REF}" \
      vcs-type="git" \
      build-date="${BUILD_DATE}" \
      url="https://github.com/stakater/certified-images/tree/main/images/prometheus" \
      com.stakater.upstream.repo="https://github.com/prometheus/prometheus" \
      com.stakater.upstream.version="${UPSTREAM_VERSION}" \
      com.stakater.upstream.commit="${UPSTREAM_COMMIT}"

# No package installs or updates here: the build has no network. OS fixes
# arrive through Renovate base-digest bumps (ADR-003 §5, ADR-004).

# Red Hat certification: /licenses (HasLicense). Keep upstream's licence files.
# Upstream ships LICENSE and NOTICE.
COPY --from=build /src/LICENSE /src/NOTICE /licenses/

# Same paths as upstream's image.
COPY --from=build --chown=1001:0 --chmod=0555 /out/prometheus /out/promtool /bin/
COPY --from=build --chown=1001:0 --chmod=0444 /src/documentation/examples/prometheus.yml /etc/prometheus/prometheus.yml
# The default data directory, writable by group 0 so an arbitrary UID can use
# it (OpenShift). Copied with its parent so that its own mode (0770, set in the
# build stage) comes along.
COPY --from=build --chown=1001:0 /out/rootfs/ /
WORKDIR /prometheus

EXPOSE 9090

# Non-root, and usable under an arbitrary UID in group 0 (OpenShift).
USER 1001

ENTRYPOINT ["/bin/prometheus"]
CMD ["--config.file=/etc/prometheus/prometheus.yml", "--storage.tsdb.path=/prometheus"]
