# Stakater build of kcp: rebuilt from upstream source on Red Hat UBI.
# Hermetic (ADR-003): scripts/build-image.sh fetches the pinned commit into ./src,
# Hermeto-prefetches Go modules into ./hermeto-output, then builds with the network off.
# Base images are parameterised and digest-pinned (ADR-004).

# Build-stage toolchain: not shipped, pinned by digest all the same (ADR-004).
# Upstream's go.mod says go 1.26.0; upstream's own Dockerfile builds with 1.26.10.
# renovate: datasource=docker depName=docker.io/library/golang
ARG GO_TAG=1.26.10@sha256:cfa27959837144bf4649802ba38e59daffd0dd2a7994aa83daaf113285b0f551
ARG BASE_REGISTRY=registry.access.redhat.com
ARG BASE_IMAGE=ubi9/ubi-minimal
# renovate: datasource=docker depName=registry.access.redhat.com/ubi9/ubi-minimal
ARG BASE_TAG=latest@sha256:08d4c70f1baf6537a0728656cf7942d561e74a35916509d205b6519861266352

########## build stage (not shipped) ##########
FROM docker.io/library/golang:${GO_TAG} AS build
# renovate: datasource=github-tags depName=kcp-dev/kcp
ARG UPSTREAM_VERSION=v0.33.6
ARG UPSTREAM_COMMIT=977a306445341854da352c534dfaa7ea40093c20
COPY src/ /src/
COPY hermeto-output/ /tmp/hermeto-output/
COPY hermeto.env /tmp/hermeto.env
WORKDIR /src
# No network here: modules come from the Hermeto cache (GOPROXY/GOMODCACHE set by hermeto.env).
# The version is what upstream's Makefile compiles in: the Kubernetes version
# kcp is built on (from go.mod), then "+kcp-" and the kcp tag.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN . /tmp/hermeto.env && \
    kube=$(go list -m -f '{{.Version}}' k8s.io/kubernetes) && \
    major=$(printf '%s' "$kube" | sed -E 's/^v([0-9]+)\..*/\1/') && \
    minor=$(printf '%s' "$kube" | sed -E 's/^v[0-9]+\.([0-9]+).*/\1/') && \
    flags="" && \
    for pkg in k8s.io/client-go/pkg/version k8s.io/component-base/version; do \
      flags="$flags -X $pkg.gitCommit=${UPSTREAM_COMMIT:0:7} -X $pkg.gitTreeState=clean -X $pkg.gitVersion=${kube}+kcp-${UPSTREAM_VERSION} -X $pkg.gitMajor=$major -X $pkg.gitMinor=$minor"; \
    done && \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags "-s -w $flags" -o /out/ \
      ./cmd/kcp ./cmd/kcp-front-proxy ./cmd/virtual-workspaces ./cmd/cache-server && \
    mkdir /out/.kcp

########## runtime stage (certified) ##########
FROM ${BASE_REGISTRY}/${BASE_IMAGE}:${BASE_TAG}

# renovate: datasource=github-tags depName=kcp-dev/kcp
ARG UPSTREAM_VERSION=v0.33.6
ARG UPSTREAM_COMMIT=977a306445341854da352c534dfaa7ea40093c20
ARG RELEASE=0
# Set by scripts/build-image.sh (ADR-009): the commit of this repository that
# built the image, when, and the digest of the base it sits on.
ARG VCS_REF=unknown
ARG BUILD_DATE=1970-01-01T00:00:00Z
ARG BASE_DIGEST=unknown
# Declared before the first FROM; repeated here so the labels can use them.
ARG BASE_REGISTRY
ARG BASE_IMAGE

# Labels (ADR-009). scripts/check-labels.sh checks every one against image.yaml
# and the build. Without them the image would inherit UBI's build date, commit,
# URL and tags.
LABEL name="stakater/kcp" \
      vendor="Stakater AB" \
      maintainer="Stakater AB <support@stakater.com>" \
      version="${UPSTREAM_VERSION}" \
      release="${RELEASE}" \
      summary="kcp multi-tenant Kubernetes-like control plane rebuilt from source on Red Hat UBI" \
      description="kcp is a Kubernetes-like control plane that serves many isolated logical clusters, called workspaces, from one server. This image holds the kcp server, its front proxy, the virtual workspaces server and the cache server. Rebuilt by Stakater from the upstream source on Red Hat Universal Base Image." \
      io.k8s.display-name="Stakater build of kcp" \
      io.k8s.description="kcp is a Kubernetes-like control plane that serves many isolated logical clusters, called workspaces, from one server. This image holds the kcp server, its front proxy, the virtual workspaces server and the cache server. Rebuilt by Stakater from the upstream source on Red Hat Universal Base Image." \
      io.openshift.tags="kcp,control-plane,multi-tenancy,workspaces,kubernetes" \
      org.opencontainers.image.title="Stakater build of kcp" \
      org.opencontainers.image.description="kcp is a Kubernetes-like control plane that serves many isolated logical clusters, called workspaces, from one server. This image holds the kcp server, its front proxy, the virtual workspaces server and the cache server. Rebuilt by Stakater from the upstream source on Red Hat Universal Base Image." \
      org.opencontainers.image.vendor="Stakater AB" \
      org.opencontainers.image.version="${UPSTREAM_VERSION}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/stakater/certified-images" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.url="https://github.com/stakater/certified-images/tree/main/images/kcp" \
      org.opencontainers.image.base.name="${BASE_REGISTRY}/${BASE_IMAGE}" \
      org.opencontainers.image.base.digest="${BASE_DIGEST}" \
      vcs-ref="${VCS_REF}" \
      vcs-type="git" \
      build-date="${BUILD_DATE}" \
      url="https://github.com/stakater/certified-images/tree/main/images/kcp" \
      com.stakater.upstream.repo="https://github.com/kcp-dev/kcp" \
      com.stakater.upstream.version="${UPSTREAM_VERSION}" \
      com.stakater.upstream.commit="${UPSTREAM_COMMIT}"

# No package installs or updates here: the build has no network. OS fixes
# arrive through Renovate base-digest bumps (ADR-003 §5, ADR-004).

# Red Hat certification: /licenses (HasLicense). Keep upstream's licence files.
# Upstream ships LICENSE only.
COPY --from=build /src/LICENSE /licenses/LICENSE

# Same paths as upstream's image, so charts written for it keep working.
COPY --from=build --chown=1001:0 --chmod=0555 /out/kcp /out/kcp-front-proxy /out/virtual-workspaces /out/cache-server /
# kcp's default data directory, relative to the working directory. Writable by
# group 0, so an arbitrary UID can use it (OpenShift). Deployments normally
# mount a volume and pass --root-directory.
COPY --from=build --chown=1001:0 --chmod=0770 /out/.kcp /.kcp

WORKDIR /
ENV KUBECONFIG=/etc/kcp/config/admin.kubeconfig

# The kcp API on 6443 (HTTPS).
EXPOSE 6443

# Non-root, and usable under an arbitrary UID in group 0 (OpenShift).
USER 1001

ENTRYPOINT ["/kcp"]
CMD ["start"]
