# Every tool the factory runs, pinned by tag@digest (ADR-003 and ADR-004 apply
# to our tools too). This is the only place a tool image is pinned: the
# Makefile includes this file and the scripts load it through scripts/lib.sh.
# Renovate keeps the entries current (renovate.json, "Tool images").
# An environment variable of the same name overrides an entry.
# Pin only images whose version tags are immutable. A digest that its
# publisher later deletes breaks every run until someone notices.

# renovate: datasource=docker depName=docker.io/hadolint/hadolint
HADOLINT_IMAGE=docker.io/hadolint/hadolint:v2.15.1-alpine@sha256:a1d49ae1a4e83c1dbad26b8c1ad7588c8bd1e04f4866b34ad3cac50335198552
# renovate: datasource=docker depName=docker.io/koalaman/shellcheck
SHELLCHECK_IMAGE=docker.io/koalaman/shellcheck:v0.11.0@sha256:61862eba1fcf09a484ebcc6feea46f1782532571a34ed51fedf90dd25f925a8d
# renovate: datasource=docker depName=docker.io/rhysd/actionlint
ACTIONLINT_IMAGE=docker.io/rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667
# renovate: datasource=docker depName=docker.io/renovate/renovate
RENOVATE_IMAGE=docker.io/renovate/renovate:44.263.3@sha256:7866a93dda59fff4f7d6ab500e1fdf9fe426f136e458fa2d123f0f2236c7c629
# renovate: datasource=docker depName=docker.io/mikefarah/yq
YQ_IMAGE=docker.io/mikefarah/yq:4.54.3@sha256:7834187596ad56fd5a81436114e0b0b9dd54c91bb43946d1f7145b2be5f9c3d2
# renovate: datasource=docker depName=ghcr.io/hermetoproject/hermeto
HERMETO_IMAGE=ghcr.io/hermetoproject/hermeto:0.64.0@sha256:b941a5258887a47deb3d741fa4a3183ec7ec3a99c1c4d0be9aa10c1d15fe0b9a
# renovate: datasource=docker depName=docker.io/anchore/syft
SYFT_IMAGE=docker.io/anchore/syft:v1.57.2@sha256:e97e20b6e6d1699c60296b66ab337941724f9bd06ac279d893eda89601fc4b2a
# renovate: datasource=docker depName=docker.io/aquasec/trivy
TRIVY_IMAGE=docker.io/aquasec/trivy:0.76.2@sha256:8f6bb947dbc528902e11f2f5be52f7b519f6a39d5d148f41166f2040499768fb
# crane, not skopeo: quay.io/skopeo/stable rebuilds its version tags and prunes
# the old digests, so a pinned digest stopped existing within a day.
# renovate: datasource=docker depName=gcr.io/go-containerregistry/crane
CRANE_IMAGE=gcr.io/go-containerregistry/crane:v0.22.1@sha256:1f968817b95790bed063f71175aa6b8ff879fa17064020415f3e18bb6e6a36e1
# Node image for the throwaway kind cluster the smoke test runs on.
# renovate: datasource=docker depName=docker.io/kindest/node
KIND_NODE_IMAGE=docker.io/kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed
# renovate: datasource=docker depName=quay.io/opdev/preflight
PREFLIGHT_IMAGE=quay.io/opdev/preflight:1.23.0@sha256:7cf165916f19e2b7321ecb476f185ac2fbca686e2c633b08a0711e3c9ddf284a
# renovate: datasource=docker depName=docker.io/library/registry
REGISTRY_IMAGE=docker.io/library/registry:3.1.2@sha256:82f6ff4a7f982960c8aa51617fea3aabc485df6e55cce80d22deb1de36f1bc3c
# cosign, to verify signatures and read the signed SBOMs when the catalogue
# site is generated (scripts/site-data.sh). The publish workflow installs its
# own cosign with sigstore/cosign-installer; keep the two on the same major
# version: cosign 2 cannot see signatures made by cosign 3.
# renovate: datasource=docker depName=ghcr.io/sigstore/cosign/cosign
COSIGN_IMAGE=ghcr.io/sigstore/cosign/cosign:v3.1.5@sha256:191099139868a6cd02abae63f2919e0915dcaa7bcc22bda6fbd11fd0dd5599e7
# grype, to scan the images we use from Red Hat when the catalogue site is
# generated (scripts/site-data.sh). trivy, which the build gate uses, does not
# recognise the packages of Red Hat Hardened Images; grype does.
# renovate: datasource=docker depName=docker.io/anchore/grype
GRYPE_IMAGE=docker.io/anchore/grype:v0.122.1@sha256:661583704a253c0448ed63998b5ea2cd9d5a76ee71eedc4aed439b8ce3e93a1c
