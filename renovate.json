{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "labels": ["upstream-bump"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Upstream tag + pinned commit in images/*/image.yaml (ADR-003)",
      "fileMatch": ["^images/[^/]+/image\\.yaml$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*version: (?<currentValue>\\S+)\\n\\s*commit: (?<currentDigest>[a-f0-9]{40})"
      ],
      "autoReplaceStringTemplate": "# renovate: datasource={{{datasource}}} depName={{{depName}}}\n  version: {{{newValue}}}\n  commit: {{{newDigest}}}"
    },
    {
      "customType": "regex",
      "description": "Parameterised UBI base in Containerfiles (ADR-004): pin and refresh tag@digest",
      "fileMatch": ["(^|/)Containerfile(\\.ubi)?$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>\\S+)\\nARG BASE_TAG=(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "autoReplaceStringTemplate": "# renovate: datasource={{{datasource}}} depName={{{depName}}}\nARG BASE_TAG={{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}"
    }
  ],
  "dockerfile": {
    "fileMatch": ["(^|/)Containerfile(\\.ubi)?$"],
    "pinDigests": true
  },
  "packageRules": [
    {
      "description": "Pin digests for the regex-managed UBI base",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "description": "UBI base digest refreshes: automerge after green CI (only route for OS CVE fixes, ADR-003 §5)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["registry.access.redhat.com/ubi9/ubi-minimal", "registry.access.redhat.com/ubi9/ubi-micro"],
      "matchUpdateTypes": ["digest", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "description": "Upstream bumps need a human: check go.mod Go version, licence, NOTICE changes",
      "matchDatasources": ["github-tags", "github-releases"],
      "automerge": false
    }
  ]
}
